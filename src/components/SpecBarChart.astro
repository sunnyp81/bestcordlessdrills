---
// Instrument-plate bar chart rendered as a real table, so the data stays readable
// at 390px, works without CSS and doubles as its own accessible fallback.
type Tone = 'premium' | 'own' | 'alliance' | 'neutral';
interface Row {
  label: string;
  sub?: string;
  value: number | null;
  display?: string;
  missing?: string;
  tone?: Tone;
}
interface Source {
  label: string;
  href?: string;
}
interface Props {
  id: string;
  title: string;
  unit: string;
  max: number;
  ticks: number[];
  rows: Row[];
  sources: Source[];
  note?: string;
  legend?: { tone: Tone; label: string }[];
  rowHeading?: string;
}
const defaultLegend: { tone: Tone; label: string }[] = [
  { tone: 'premium', label: 'Major tool brand' },
  { tone: 'own', label: 'Own-brand or budget range' },
];
const { id, title, unit, max, ticks, rows, sources, note, legend = defaultLegend, rowHeading = 'Model' } = Astro.props as Props;
const pct = (v: number) => `${Math.max(0, Math.min(100, (v / max) * 100)).toFixed(2)}%`;
---
<figure class="sbc" aria-labelledby={`${id}-title`}>
  <figcaption class="sbc__head">
    <span class="sbc__title" id={`${id}-title`}>{title}</span>
    {legend.length > 0 && (
      <span class="sbc__legend">
        {legend.map((l) => <span class={`sbc__key sbc__key--${l.tone}`}>{l.label}</span>)}
      </span>
    )}
  </figcaption>
  <table class="sbc__table">
    <thead>
      <tr>
        <th scope="col">{rowHeading}</th>
        <th scope="col">
          <span class="sr-only">{unit}</span>
          <span class="sbc__scale" aria-hidden="true">
            {ticks.map((t) => (
              <span class="sbc__tick" style={`left:${pct(t)}`}>{t}</span>
            ))}
          </span>
        </th>
      </tr>
    </thead>
    <tbody>
      {rows.map((r) => (
        <tr data-tone={r.tone ?? 'neutral'}>
          <th scope="row">
            <span class="sbc__label">{r.label}</span>
            {r.sub && <span class="sbc__sub">{r.sub}</span>}
          </th>
          <td>
            {r.value === null ? (
              <span class="sbc__track">
                <span class="sbc__missing">{r.missing ?? 'Not published'}</span>
              </span>
            ) : (
              <span class="sbc__track">
                <span class="sbc__bar" style={`width:${pct(r.value)}`}></span>
                <span class="sbc__value figure">{r.display ?? `${r.value} ${unit}`}</span>
              </span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="sbc__foot">
    {note && <p class="sbc__note">{note}</p>}
    <p class="sbc__source">
      Source{sources.length > 1 ? 's' : ''}:{' '}
      {sources.map((s, i) => (
        <>
          {s.href ? <a href={s.href} rel="nofollow noopener" target="_blank">{s.label}</a> : <span>{s.label}</span>}
          {i < sources.length - 1 ? '; ' : '.'}
        </>
      ))}
    </p>
  </div>
</figure>

<style>
  .sbc {
    margin: 2rem 0;
    background: var(--color-ink-950);
    color: var(--color-steel-300);
    border: 1px solid var(--color-ink-800);
    border-radius: 3px;
    overflow: hidden;
  }
  .sbc__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    padding: 1rem 1.1rem 0.85rem;
    border-bottom: 1px solid var(--color-ink-800);
  }
  .sbc__title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.3;
    color: #fff;
  }
  .sbc__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
  }
  .sbc__key {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .sbc__key::before {
    content: "";
    width: 0.9rem;
    height: 0.55rem;
    border-radius: 1px;
  }
  .sbc__key--premium::before { background: var(--color-amber-500); }
  .sbc__key--alliance::before { background: #C9D1D9; }
  .sbc__key--neutral::before { background: var(--color-steel-300); }
  .sbc__key--own::before {
    background: repeating-linear-gradient(135deg, #7FA8C9 0 3px, #4F7FA6 3px 6px);
  }
  .sbc__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .sbc__table thead th {
    padding: 0.55rem 1.1rem 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: left;
    color: var(--color-steel-300);
    vertical-align: bottom;
  }
  .sbc__table thead th:first-child { width: 38%; }
  .sbc__scale {
    position: relative;
    display: block;
    height: 1.1rem;
    margin-right: 4.6rem;
    border-bottom: 1px solid var(--color-steel-500);
  }
  .sbc__tick {
    position: absolute;
    bottom: 0.2rem;
    transform: translateX(-50%);
    letter-spacing: 0;
  }
  .sbc__tick:first-child { transform: none; }
  .sbc__table tbody th,
  .sbc__table tbody td {
    padding: 0.6rem 1.1rem;
    border-top: 1px solid var(--color-ink-800);
    vertical-align: middle;
  }
  .sbc__table tbody th { text-align: left; font-weight: 400; }
  .sbc__label {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.92rem;
    color: #fff;
    line-height: 1.25;
  }
  .sbc__sub {
    display: block;
    font-size: 0.74rem;
    color: var(--color-steel-300);
    margin-top: 0.1rem;
  }
  .sbc__table tbody td { padding-left: 0; }
  .sbc__track {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.4rem;
    padding-right: 4.6rem;
    background-origin: content-box;
    background-clip: content-box;
    background-image: repeating-linear-gradient(90deg, rgba(154, 163, 173, 0.16) 0 1px, transparent 1px 10%);
  }
  .sbc__bar {
    display: block;
    height: 0.95rem;
    border-radius: 1px;
    background: var(--color-steel-300);
    flex-shrink: 0;
  }
  tr[data-tone="premium"] .sbc__bar { background: var(--color-amber-500); }
  tr[data-tone="alliance"] .sbc__bar { background: #C9D1D9; }
  tr[data-tone="own"] .sbc__bar {
    background: repeating-linear-gradient(135deg, #7FA8C9 0 3px, #4F7FA6 3px 6px);
  }
  .sbc__value {
    font-size: 0.82rem;
    font-weight: 500;
    color: #fff;
    white-space: nowrap;
  }
  .sbc__missing {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-steel-300);
    border: 1px dashed var(--color-steel-500);
    padding: 0.1rem 0.45rem;
    border-radius: 1px;
  }
  .sbc__foot {
    padding: 0.8rem 1.1rem 0.95rem;
    border-top: 1px solid var(--color-ink-800);
    font-size: 0.78rem;
    line-height: 1.55;
  }
  .sbc .sbc__note,
  .sbc .sbc__source { font-size: 0.8rem; line-height: 1.55; color: var(--color-steel-300); }
  .sbc .sbc__note { margin: 0 0 0.35rem; }
  .sbc .sbc__source { margin: 0; }
  .sbc__source a {
    color: var(--color-amber-300);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sbc__source a:hover { color: #fff; }
  .sbc__source a:focus-visible { outline-color: var(--color-amber-500); }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 520px) {
    .sbc__table thead th:first-child { width: 42%; }
    .sbc__table tbody th, .sbc__table tbody td { padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .sbc__table thead th, .sbc__table tbody th { padding-left: 0.8rem; padding-right: 0.6rem; }
    .sbc__label { font-size: 0.85rem; }
    .sbc__scale { margin-right: 4.8rem; }
    .sbc__track { padding-right: 4.8rem; }
    .sbc__value { font-size: 0.76rem; }
    .sbc__tick:not(:first-child):not(:last-child) { display: none; }
  }
</style>
